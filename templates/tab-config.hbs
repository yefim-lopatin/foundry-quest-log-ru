<form style="text-align: left;" action="submit">

    <div class="form-group">
        <label for="quests">{{localize "foundry-quest-log-ru.simple-quest.tabs.quests"}} {{localize "foundry-quest-log-ru.simple-quest.tabs.tab"}}</label>
        <input type="text" name="quests" value="{{localize quests}}">
    </div>

    <div class="form-group">
        <label for="lore">{{localize "foundry-quest-log-ru.simple-quest.tabs.lore"}} {{localize "foundry-quest-log-ru.simple-quest.tabs.tab"}}</label>
        <input type="text" name="lore" value="{{localize lore}}">
    </div>

    <div class="form-group">
        <label for="timeline">{{localize "foundry-quest-log-ru.simple-quest.tabs.timeline"}} {{localize "foundry-quest-log-ru.simple-quest.tabs.tab"}}</label>
        <input type="text" name="timeline" value="{{localize timeline}}">
    </div>

    <div class="form-group">
        <label for="map">{{localize "foundry-quest-log-ru.simple-quest.tabs.map"}} {{localize "foundry-quest-log-ru.simple-quest.tabs.tab"}}</label>
        <input type="text" name="map" value="{{localize map}}">
    </div>

    <div class="form-group">
        <label for="achievements">{{localize "foundry-quest-log-ru.simple-quest.tabs.achievements"}} {{localize "foundry-quest-log-ru.simple-quest.tabs.tab"}}</label>
        <input type="text" name="achievements" value="{{localize achievements}}">
    </div>

    <div class="form-group">
        <label for="my-journal">{{localize "foundry-quest-log-ru.simple-quest.tabs.my-journal"}} {{localize "foundry-quest-log-ru.simple-quest.tabs.tab"}}</label>
        <input type="text" name="my-journal" value="{{localize my-journal}}">
    </div>

    <div class="form-group">
        <label for="party-journal">{{localize "foundry-quest-log-ru.simple-quest.tabs.party-journal"}} {{localize "foundry-quest-log-ru.simple-quest.tabs.tab"}}</label>
        <input type="text" name="party-journal" value="{{localize party-journal}}">
    </div>

    <footer class="flexrow">
    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{localize "Save"}}</button>
    </footer>
</form>